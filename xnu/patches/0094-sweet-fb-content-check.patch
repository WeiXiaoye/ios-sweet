+/*
+ * Is there anything to show? iOS submits surfaces before they are painted,
+ * and copying one of those blanks the panel; sample every 8th pixel because a
+ * full 1080x2340 scan per swap would cost more than the copy itself.
+ */
+static bool
+sweet_surface_has_content(SweetSurface *s)
+{
+	uintptr_t base = s->kernelAddress();
+	if (base == 0 || s->bytesPerRow == 0 || s->memory == NULL) {
+		return false;
+	}
+	for (uint32_t y = 0; y < s->height; y += 8) {
+		volatile uint32_t *row = (volatile uint32_t *)(base + s->offset +
+		    (uint64_t)y * s->bytesPerRow);
+		for (uint32_t x = 0; x < s->width; x += 8) {
+			if ((row[x] & 0x00ffffffu) != 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
