+/*
+ * MIX 3: STMicroelectronics "FTS" at 0x49 (the e5 panel; st_fts_e5.ftb in the
+ * vendor tree). Report at register 0x00: byte 0 carries the number of points
+ * in its low nibble, then six bytes per point -- id in the high nibble of
+ * byte 2, x = (b0 & 0x0f) << 8 | b1, y = (b2 & 0x0f) << 8 | b3. The first
+ * frame is logged raw so a different layout is visible in the log.
+ */
+static int
+touch_stfts(void)
+{
+	static bool dumped;
+	uint8_t buf[1 + 6 * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x49, 0, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	if (!dumped) {
+		dumped = true;
+		printf("SWEET TOUCH: ST FTS raw %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7]);
+	}
+	unsigned n = buf[0] & 0x0fu;
+	if (n > TOUCH_MAX) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 1 + 6 * i;
+		unsigned id = p[2] >> 4;
+		unsigned px = ((unsigned)(p[0] & 0x0fu) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 0x0fu) << 8) | p[3];
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || px > 1079 || py > 2339) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
