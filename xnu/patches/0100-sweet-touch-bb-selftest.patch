--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -791,6 +791,23 @@
 	touch_wait(2);
 	touch_gpio(32, 0, 3, 7, true, true);
 	touch_wait(300); /* exceeds vendor 5 ms test + 95 ms post-test wait */
+	/* bit-bang self test: drive each line, then release it and read the pad */
+	{
+		bb_low(BB_SDA);
+		bb_delay();
+		unsigned sda_low = bb_level(BB_SDA);
+		bb_release(BB_SDA);
+		bb_delay();
+		unsigned sda_high = bb_level(BB_SDA);
+		bb_low(BB_SCL);
+		bb_delay();
+		unsigned scl_low = bb_level(BB_SCL);
+		bb_release(BB_SCL);
+		bb_delay();
+		unsigned scl_high = bb_level(BB_SCL);
+		printf("SWEET TOUCH: bb selftest sda low=%u high=%u scl low=%u high=%u\n",
+		    sda_low, sda_high, scl_low, scl_high);
+	}
 	uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
 	st.probing = true;
 	int ge = touch_probe_info(GOODIX_PID_REG, gid);
